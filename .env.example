# WebDAV Configuration for Backup
# Copy this file to .env and fill in your WebDAV server details

# WebDAV server URL (required)
VITE_WEBDAV_URL=https://your-webdav-server.com/remote.php/webdav

# WebDAV username (optional, comment out if not needed)
#VITE_WEBDAV_USERNAME=your-username

# WebDAV password (optional, defaults to empty if not set)
#VITE_WEBDAV_PASSWORD=your-password
